# cks-loadtest configuration.
# Every value can also be passed as a CLI flag (CLI > env > --config file).
# Copy to loadtest.env, fill in, then either `export $(grep -v '^#' loadtest.env | xargs)`
# or run with `--config loadtest.env`.
#
# loadtest.env, roster JSON, and other *.env files are gitignored: a roster holds
# live bearer tokens.

# --- required -----------------------------------------------------------
# Base account. Per-client accounts are derived from this email using
# LT_EMAIL_PATTERN and share this password. The tool registers them on the
# first run (idempotent: later runs just log in).
#
# Prefer LT_PASSWORD over --password. argv is visible in ps(1).
LT_EMAIL=you@example.com
LT_PASSWORD=change-me-8chars-min

# The CK GraphQL base URL (identity + app token minting). The management and game
# surfaces are ONE origin, so this is the same host the game clients use.
#
# NO HOSTNAME IN THIS FILE, deliberately. A value that is correct on one
# deployment is the wrong origin on another, and a default that happens to
# resolve produces a run that passes while measuring a host players never reach.
# Set it from the origin your game already dials.
LT_MANAGEMENT_API_URL=

# The app to load test. The derived accounts must be entitled to it —
# the load tester does not manage tiers or entitlements. CK mints 64-bit
# snowflake app ids, unique per deployment; a rebuild orphans the old id.
# Resolve by slug (the public appBySlug query) rather than copying a number.
# There is no default: 0 is a refusal.
LT_APP_ID=

# --- scale ---------------------------------------------------------------
LT_CLIENTS=10
# Max clients this process will ever hold. Unset, this equals LT_CLIENTS and
# HTTP add is refused. For a fleet generator that starts empty and grows:
#   LT_CLIENTS=0
#   LT_INDEX_LIMIT=2000
#LT_INDEX_LIMIT=
# First GLOBAL client index this process owns. VM i of a fleet with capacity C
# each uses LT_INDEX_BASE=$((i * C)). Emails and roster keys use this index.
#LT_INDEX_BASE=0
# Zero-pad width of {index} in LT_EMAIL_PATTERN. Default 4 (compat, max 9999).
# Use 8 for a large fleet.
#LT_INDEX_WIDTH=4
# Stamped on every stats blob (default: hostname).
#LT_INSTANCE_ID=
LT_THREADS=1
LT_UPDATE_HZ=10
LT_WALK_SPEED=150
LT_SPAWN_RADIUS_CHUNKS=8
#LT_DISTANCE=8
#LT_DECAY=1

# The radius, in chunks, of the server's cached grid-permission box. Used ONLY
# to classify UNAUTHORIZED refusals in the summary -- never sent on the wire.
# The server's value is its own constant and a client cannot read it, so this is
# a declared assumption: set it too small and ordinary refusals get filed as
# window reloads, too large and they land in UNEXPLAINED. See the README section
# on interpreting UNAUTHORIZED before changing it.
#LT_PERMISSION_WINDOW_RADIUS_CHUNKS=8
# How long after a window-crossing refusal the follow-on refusals count as the
# same reload episode. The server evicts a stale window under a backoff, so one
# crossing legitimately costs several packets rather than one.
#LT_PERMISSION_RELOAD_GRACE_MS=5000

# --- ramp-up / provisioning ---------------------------------------------
LT_RAMP_BATCH_SIZE=10
LT_RAMP_INTERVAL_MS=1000
# Re-assign a client that heard nothing for this long (0 = off; 30 on fleet runs).
LT_RX_SILENT_REASSIGN_SEC=0
LT_PROVISION_CONCURRENCY=4

# --- run control ----------------------------------------------------------
# 0 = run until Ctrl-C (or POST /v1/shutdown).
LT_DURATION_SEC=0
LT_STATS_INTERVAL_SEC=5
#LT_CSV_OUT=loadtest-stats.csv
# Directory for rung-*.json and intervals.jsonl (created if missing).
#LT_STATS_DIR=

# --- HTTP control (cks-loadtest-ctl / an orchestrating agent) --------------
# Default is loopback. Binding anything else REQUIRES LT_CONTROL_TOKEN.
# There is no TLS on this port: put it on a private network or firewall it.
# Set to "off" to disable.
#LT_CONTROL_BIND=127.0.0.1:9109
#LT_CONTROL_TOKEN=

# --- advanced -------------------------------------------------------------
# Game API is discovered from mintAppToken; override only if needed.
#LT_GAME_API_URL=
# Derived email pattern; {local} and {domain} come from LT_EMAIL.
#LT_EMAIL_PATTERN={local}+lt-{index}@{domain}
# Verify the HMAC on signed server notifications (extra CPU per packet).
#LT_VERIFY_SERVER_HMAC=0
# Skip TLS verification (self-signed dev endpoints only).
#LT_TLS_INSECURE=0
# Wait after server assignment before the first UDP packet (session install).
#LT_SESSION_SETTLE_MS=1500
# Abort if we sent traffic but received nothing after this many seconds.
#LT_RX_HEALTH_TIMEOUT_SEC=10
# Rotate app tokens this many seconds before their expiry.
#LT_TOKEN_REFRESH_LEAD_SEC=120
